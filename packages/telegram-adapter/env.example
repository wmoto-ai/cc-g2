# telegram-adapter 設定テンプレート
# 使い方: `cp env.example .env` して値を埋める(.env は gitignore 済み。chmod 600 推奨)
# 起動: scripts/start-prod.sh(tmux 常駐、推奨)または pnpm start
#
# 1Password 運用(任意): 値の代わりに op:// 参照を書き、
#   op-sa run --env-file=.env -- pnpm start  や  op run --env-file=.env -- pnpm start
# で起動すると実値がプロセスにだけ注入される。
# `env.example` は公開テンプレートで、実値を入れる `.env` は gitignore 済み。

# --- Telegram ---
# @BotFather に /newbot を送って bot を作成すると token がもらえる(例: 123456789:AAH...)
# ⚠️ 1 つの bot token を同時に polling できるのは 1 プロセスだけ(409 で落ちる)。
#    公式 Claude Code telegram plugin 等が同じ bot を使っている場合は、
#    そちらを止めるか、このアダプタ用に別 bot を作ること。
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# カンマ区切りの数値 user id。必須(空だと起動拒否)。
# 自分の id は Telegram で @userinfobot に DM すると分かる。
TELEGRAM_ALLOWED_USER_IDS=123456789
# 通知投稿先 chat(private chat は user id と同値)。省略時は allowlist の先頭
#TELEGRAM_CHAT_ID=123456789

# --- Hub ---
HUB_BASE_URL=http://127.0.0.1:8787
# Hub の認証トークン。実体は「Hub を起動したチェックアウトの
# tmp/notification-hub/hub-auth-token」ファイル(Hub 初回起動時に自動生成)。
#   HUB_AUTH_TOKEN=$(cat <cc-g2リポジトリ>/tmp/notification-hub/hub-auth-token)
# scripts/start-prod.sh はこのファイルを実行時に自動で読むので、その場合ここは不要。
# Hub 側で HUB_AUTH_TOKEN 未設定なら空で可。
#HUB_AUTH_TOKEN=

# --- 動作パラメータ(省略可、既定値あり) ---
#RECONCILE_INTERVAL_MS=30000
# 既投稿の無効化閾値。Hub hooks.mjs HOOK_POLL_TIMEOUT_MS(600s)と一致させる
#APPROVAL_STALE_MS=600000
# 新規投稿の打ち切り閾値。STALE より短く(境界レース回避)
#APPROVAL_POST_CUTOFF_MS=540000
# decide 操作の安全マージン。ガードは STALE - この値 で遮断
# (hook の decide 監視が 2 秒間隔ポーリングのため、境界ぎりぎりの decide が
#  タイムアウトに食われるレースを防ぐ)。STALE より小さいこと
#APPROVAL_DECIDE_MARGIN_MS=30000
#DATA_DIR=./data
# 受信ファイル(画像/PDF/テキスト/音声/動画)の保存先
# (既定 <DATA_DIR>/inbox。start-prod.sh は ~/.local/share/cc-tg-adapter/inbox)
#INBOX_DIR=
# 受信ファイルのサイズ上限バイト(既定 10MB)。Bot API getFile の 20MB 上限
# (公式 FAQ 確認済みの現行仕様)以下にすること。20MB 超が必要になったら
# ローカル Bot API サーバー(self-host、download 無制限)+ apiRoot 差し替えで対応可能
#INBOX_MAX_BYTES=10485760
# Stop 通知への返信(テキスト・画像)を受け付ける期限 ms(既定 24h。超過は追跡外扱い)
#STOP_REPLY_TTL_MS=86400000
#LOG_LEVEL=info
