# Groq STT — API key for the Hub (server-side only, not exposed to the browser)
# Copy to .env.local and set your key.
GROQ_API_KEY=

# OpenAI Realtime Whisper — API key for ephemeral token issuance (server-side only)
OPENAI_API_KEY=

# Soniox Realtime STT — API key for temporary token issuance (server-side only)
SONIOX_API_KEY=

# STT options (VITE_ vars are passed to the browser bundle by Vite)
# Groq model (default: whisper-large-v3 — src/config.ts). Example override:
# VITE_GROQ_MODEL=whisper-large-v3-turbo
VITE_STT_ENABLED=true
VITE_STT_FORCE_ERROR=false
# STT provider: "groq" (default, REST batch), "openai-realtime" (WebSocket streaming), or "soniox" (WebSocket streaming)
VITE_STT_PROVIDER=groq

# Optional: Claude Code StatusLine hook integration
# Default is auto: if ~/.claude/settings.json has statusLine.command, cc-g2 wraps it automatically.
# Set to 0 to disable, or 1 to force-enable.
# CC_G2_ENABLE_STATUSLINE=0

# Notification Hub URL
# 通常は設定不要（ページのホスト名から自動解決される）
# 明示的に指定する場合のみ設定:
# VITE_HUB_URL=http://127.0.0.1:8787

# Hub auth token
# 通常は cc-g2 が自動生成して Vite dev server に注入するため設定不要
# 手動起動時のみ必要なら設定:
# VITE_HUB_TOKEN=replace-me
# Hub が受け付ける Host ヘッダの追加許可（DNS rebinding 対策）。IP アドレス・localhost・*.ts.net は常に許可。
# 自前のホスト名で Hub / G2 アプリにアクセスする場合だけ設定する（カンマ区切り、先頭 "." はサフィックス一致）
# HUB_ALLOWED_HOSTS=hub.home.arpa,.lan

# Diagnostics (VITE_ vars are passed to the browser bundle by Vite)
# クライアントの全ログを Hub にミラー送信する診断モード。デフォルト無効。
# 原因追跡が必要なときだけ 1 にする（待機中の余計な送信を避けるため）。
# VITE_LOG_MIRROR=0

# Transport: "hub" (default) or "telegram". 設定画面で保存した値・?transport= が優先
# VITE_TRANSPORT=hub

# Notifications (defaults: true)
# 新着通知で G2 の通知画面を自動で開く
# VITE_NOTIF_AUTO_OPEN_ON_NEW=true
# 待機画面を消灯表示（空白）にする
# VITE_NOTIF_IDLE_DIM_MODE=true

# G2 mirror (defaults: false). ?mirror=1 / ?mirrorpub=1 でもセッション限定で有効化できる
# ページ内に G2 表示の近似ミラーを出す
# VITE_MIRROR=false
# ミラー状態を Hub 経由で mirror.html ビューアへ配信する
# VITE_MIRROR_PUBLISH=false

# Image transfer tuning (BLE 負荷の切り分け用。?imgtile= / ?imgdelay= / ?imgsettle= でも指定可)
# タイルサイズ: 288 (default) / 256 / 200 / WxH
# VITE_IMG_TILE=288
# タイル間ディレイ ms (default: 100)
# VITE_IMG_TILE_DELAY_MS=100
# レイアウト構築後、最初のタイル送信までの待ち ms (default: 300)
# VITE_IMG_SETTLE_MS=300

# Voice entry (G2 voice -> cc-g2 session launcher)
# Enabled by default. Set to 0 to disable.
# CC_G2_VOICE_ENTRY_ENABLED=0
# CC_G2_REPO_ROOTS=$HOME/Repos
# CC_G2_REPO_SCAN_DEPTH=3
